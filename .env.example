# =============================================================================
#  L'Essence Noire — Mẫu biến môi trường (server)
# -----------------------------------------------------------------------------
#  Hướng dẫn:
#    1) Sao chép file này thành server/.env:  cp .env.example server/.env
#    2) Điền giá trị thật cho các biến (bắt buộc) ở phần dưới.
#    3) TUYỆT ĐỐI không commit file .env thật. Xoay (rotate) mọi khóa đã từng lộ.
#
#  Chú thích: (bắt buộc) = không có sẽ không chạy; (tùy chọn) = có giá trị mặc định.
# =============================================================================

# -----------------------------------------------------------------------------
#  1. Ứng dụng & máy chủ
# -----------------------------------------------------------------------------
NODE_ENV=development                 # development | production | test
PORT=5000                            # Cổng API server
API_PREFIX=/api/v1                   # Tiền tố phiên bản API

# Số proxy tin cậy đặt trước app (0 khi chạy trực tiếp; 1 khi sau 1 lớp Nginx).
# Cần đúng để req.ip chính xác và secure cookie hoạt động sau reverse proxy.
TRUST_PROXY=1

# -----------------------------------------------------------------------------
#  2. Cơ sở dữ liệu (MongoDB) — (bắt buộc)
# -----------------------------------------------------------------------------
# Local single-node replica set (khuyến nghị để bật transaction):
MONGO_URI=mongodb://127.0.0.1:27017/lessence_noire?replicaSet=rs0
# Hoặc MongoDB Atlas:
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/lessence_noire?retryWrites=true&w=majority

# -----------------------------------------------------------------------------
#  3. Redis (tùy chọn) — rate-limit phân tán khi chạy nhiều instance
# -----------------------------------------------------------------------------
# Để trống để dùng rate-limit trong bộ nhớ (phù hợp 1 instance).
REDIS_URL=
# REDIS_URL=redis://127.0.0.1:6379

# -----------------------------------------------------------------------------
#  4. Xác thực (JWT) — (bắt buộc)
# -----------------------------------------------------------------------------
# Sinh chuỗi ngẫu nhiên mạnh, ví dụ:  openssl rand -hex 32
JWT_ACCESS_SECRET=thay_bang_chuoi_bi_mat_ngau_nhien_manh
JWT_REFRESH_SECRET=thay_bang_chuoi_bi_mat_khac_ngau_nhien_manh
JWT_ACCESS_EXPIRES=15m               # Thời hạn access token (giữ trong bộ nhớ)
JWT_REFRESH_EXPIRES=7d               # Thời hạn refresh token (httpOnly cookie)

# Tên cookie refresh + cấu hình cookie
REFRESH_COOKIE_NAME=ln_rt
COOKIE_DOMAIN=                       # Để trống ở local; ví dụ .lessence-noire.com ở prod
COOKIE_SECURE=false                  # true khi chạy HTTPS/production

# Băm mật khẩu (bcrypt)
BCRYPT_SALT_ROUNDS=12

# -----------------------------------------------------------------------------
#  5. Bảo mật & CORS
# -----------------------------------------------------------------------------
# URL của client (dùng cho link email, redirect, ...)
CLIENT_URL=http://localhost:5173

# Danh sách origin được phép (CORS allowlist), phân cách bằng dấu phẩy
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# CSRF double-submit token (mặc định bật). Đặt false chỉ khi debug.
CSRF_ENABLED=true

# Giới hạn kích thước body (chống payload lớn)
BODY_LIMIT=100kb

# Rate limit (cửa sổ tính bằng phút & số request tối đa mỗi cửa sổ)
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=100

# -----------------------------------------------------------------------------
#  6. Lưu trữ ảnh (Cloudinary) — (bắt buộc nếu dùng upload ảnh)
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=lessence-noire     # Thư mục lưu ảnh trên Cloudinary

# -----------------------------------------------------------------------------
#  7. Thanh toán VietQR + Webhook SePay
# -----------------------------------------------------------------------------
VIETQR_BANK_ID=                      # Mã ngân hàng (BIN), ví dụ 970436 (Vietcombank)
VIETQR_ACCOUNT_NO=                   # Số tài khoản nhận tiền
VIETQR_ACCOUNT_NAME=                 # Tên chủ tài khoản (không dấu, IN HOA)
VIETQR_TEMPLATE=compact              # Mẫu ảnh QR: compact | qr_only | print

# Bí mật xác thực webhook (HMAC-SHA256) từ SePay
SEPAY_WEBHOOK_SECRET=
SEPAY_WEBHOOK_TOLERANCE_SECONDS=300  # Cửa sổ chống replay (± giây)

# -----------------------------------------------------------------------------
#  8. Email (SMTP) — gửi voucher chào mừng, thông báo đơn hàng
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587                        # 587 (STARTTLS) hoặc 465 (SSL)
SMTP_SECURE=false                    # true nếu dùng cổng 465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="L'Essence Noire <no-reply@lessence-noire.com>"

# Công tắt tổng cho email khuyến mãi (bật/tắt toàn bộ email marketing)
PROMO_EMAILS_ENABLED=true

# -----------------------------------------------------------------------------
#  9. Giám sát lỗi (tùy chọn) — Sentry
# -----------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1        # Tỉ lệ lấy mẫu trace (0.0 - 1.0)

# -----------------------------------------------------------------------------
#  10. Seed / Tài khoản admin mặc định (dùng cho script create-admin)
# -----------------------------------------------------------------------------
ADMIN_EMAIL=admin@lessence-noire.com
ADMIN_PASSWORD=doi_mat_khau_nay_ngay
ADMIN_NAME=Administrator
