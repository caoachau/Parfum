# ============================================================
#  L'Essence Noire - .gitignore (monorepo goc)
# ============================================================

# --- Dependencies ---
node_modules/
.pnp/
.pnp.js
.yarn/

# --- Build output ---
dist/
dist-*/
build/
out/
*.tsbuildinfo
.vite/

# --- Prerender / SSR (react-snap) ---
# HTML tinh sinh ra khi prerender nam trong client/dist (da bo qua theo dist/)

# --- Test / coverage ---
coverage/
.nyc_output/

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/

# --- Environment / secrets ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Database backup (script backup.ts) ---
backups/
server/backups/
*.dump
*.bson
*.archive

# --- Uploads (anh nguoi dung tai len, khong commit) ---
server/uploads/*
!server/uploads/.gitkeep

# --- Editor / IDE ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
.idea/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Misc ---
.cache/
.temp/
tmp/
*.local
